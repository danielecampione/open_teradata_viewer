# Handle all images as binary data, without performing any conversions
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.svg binary
# Handle binary files (libraries, archives, executables, etc.) without performing any conversions
*.jar binary
*.class binary
*.war binary
*.ear binary
*.zip binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary